  const auto&a=textDraws[i];const auto&b=textDraws[j];
  const bool overlap=a.x<b.x+b.w && b.x<a.x+a.w && a.y<b.y+b.h && b.y<a.y+a.h;
  if(overlap){fprintf(stderr,"TEXT COLLISION page=%u: [%s] %d,%d %dx%d with [%s] %d,%d %dx%d\n",displayState.currentPage,a.text.c_str(),a.x,a.y,a.w,a.h,b.text.c_str(),b.x,b.y,b.w,b.h);abort();}
 }
}
void checkBounds(){
 for(auto &d:textDraws){
  if(d.x<0||d.y<0||d.x+d.w>240||d.y+d.h>240){fprintf(stderr,"Overflow: %s at %d,%d %dx%d\n",d.text.c_str(),d.x,d.y,d.w,d.h);abort();}
  if(d.h<16){fprintf(stderr,"Too small: %s at %d,%d %dx%d\n",d.text.c_str(),d.x,d.y,d.w,d.h);abort();}
  if(d.y<212&&d.y+d.h>212){fprintf(stderr,"Footer boundary: %s at %d,%d %dx%d\n",d.text.c_str(),d.x,d.y,d.w,d.h);abort();}
 }
 assert(tft.textSize==1&&clockDynamicSprite.textSize==1);
}
