+    } else if (upload.status == UPLOAD_FILE_ABORTED) {
+        gifPlayerUploadAbort();
+        gifUploadError = "GIF upload aborted";
+    } else if (upload.status == UPLOAD_FILE_END && gifUploadError.isEmpty()) {
+        if (gifPlayerUploadEnd()) {
+            gifUploadComplete = true;
+        } else {
+            gifPlayerUploadAbort();
+            gifUploadError = "GIF could not be committed to storage";
+        }
+    }
