+void handleGifForm() {
+    static const char html[] PROGMEM =
+        "<!doctype html><html><head><meta name='viewport' content='width=device-width,initial-scale=1'>"
+        "<title>ROBCO GIF ARCHIVE</title><style>body{background:#071008;color:#7cff75;font:16px monospace;"
+        "max-width:520px;margin:32px auto;padding:16px}fieldset{border:1px solid #4c9b4a;padding:18px}"
+        "button,input{font:inherit;margin:12px 0}button{background:#17351a;color:#a5ff9a;border:1px solid #7cff75;"
+        "padding:10px 16px}</style></head><body><h2>ROBCO // VISUAL ARCHIVE</h2>"
+        "<p>Upload a GIF to the device album. Maximum 300 KiB per file; up to twelve files are indexed.</p>"
+        "<p>GIFs must have a maximum 240x240 canvas, use 11-bit-or-smaller LZW codes, and contain flattened opaque full-canvas frames.</p>"
+        "<form action='/gif/upload' method='post' enctype='multipart/form-data'>"
+        "<fieldset><input type='file' name='file' accept='.gif,image/gif' required><br>"
+        "<button type='submit'>UPLOAD TO ARCHIVE</button></fieldset></form>"
+        "<p>Existing files with the same name are replaced only after a complete upload.</p></body></html>";
+    server.send_P(200, PSTR("text/html"), reinterpret_cast<PGM_P>(html), sizeof(html));
+}
+
+void handleGifUpload() {
+    HTTPUpload &upload = server.upload();
+    if (upload.status == UPLOAD_FILE_START) {
+        gifUploadComplete = false;
+        gifUploadError = "";
+        if (feedsBusy() || webserverHasPendingNetworkAction()) {
+            gifUploadError = "Another network task is running";
+            return;
+        }
+        if (!gifPlayerUploadStart(upload.filename.c_str())) {
+            gifUploadError = "Invalid GIF filename or storage unavailable";
+        }
+    } else if (upload.status == UPLOAD_FILE_WRITE && gifUploadError.isEmpty()) {
+        if (!gifPlayerUploadChunk(upload.buf, upload.currentSize)) {
+            gifUploadError = "GIF write failed or file exceeds 300 KiB";
+            gifPlayerUploadAbort();
+        }
+    } else if (upload.status == UPLOAD_FILE_ABORTED) {
+        gifPlayerUploadAbort();
+        gifUploadError = "GIF upload aborted";
+    } else if (upload.status == UPLOAD_FILE_END && gifUploadError.isEmpty()) {
+        if (gifPlayerUploadEnd()) {
+            gifUploadComplete = true;
+        } else {
+            gifPlayerUploadAbort();
+            gifUploadError = "GIF could not be committed to storage";
+        }
+    }
+}
+
+void handleGifUploadDone() {
+    if (gifUploadComplete && gifUploadError.isEmpty()) {
+        sendTextResponse(200, F("GIF uploaded"));
+    } else {
+        sendTextResponse(400, gifUploadError.length() ? gifUploadError : String("Incomplete GIF upload"));
+    }
+}
