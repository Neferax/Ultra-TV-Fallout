+    if (status.rssi == 0 || status.rssi < -80) {
+        signalLabel = "SIGNAL SCHWACH";
+        signalColor = 0xF800;
+    } else if (status.rssi < -70) {
+        signalLabel = "SIGNAL OK";
+        signalColor = 0xFFE0;
+    }
+    snprintf(line, sizeof(line), "%s %d DBM", signalLabel, status.rssi);
+    drawDisplayLabel(line, 12, 66, 216, TL_DATUM, signalColor, FONT_LABEL);
+    snprintf(line, sizeof(line), "RAM %u KB FREI", static_cast<unsigned>(status.freeHeap / 1024UL));
+    drawDisplayLabel(line, 12, 92, 216, TL_DATUM, 0xAFE5, FONT_LABEL);
+    const uint32_t seconds = status.uptimeSeconds % 86400UL;
+    snprintf(line, sizeof(line), "UPTIME %02u:%02u:%02u",
+             static_cast<unsigned>(seconds / 3600UL),
+             static_cast<unsigned>((seconds / 60UL) % 60UL),
