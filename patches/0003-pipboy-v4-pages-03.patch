diff --git a/src/feeds.cpp b/src/feeds.cpp
index 5d297ce..e81599e 100644
--- a/src/feeds.cpp
+++ b/src/feeds.cpp
@@ -2101,2 +2101,60 @@ void applyConfigObject(JsonObjectConst root) {
 
+bool syncRadAirQuality(String *error) {
+    if (WiFi.status() != WL_CONNECTED) {
+        return false;
+    }
+
+    RadFeedRuntime &runtime = feedRuntime.rad;
+    runtime.syncing = true;
+    runtime.lastAttemptMs = millis();
+    runtime.lastError[0] = '\0';
+
+    String url = "http://air-quality-api.open-meteo.com/v1/air-quality?latitude=" +
+                 String(feedConfig.weather.latitude, 4) +
+                 "&longitude=" + String(feedConfig.weather.longitude, 4) +
+                 "&current=european_aqi,pm2_5,pm10,grass_pollen,birch_pollen,alder_pollen&timezone=auto";
+
+    JsonDocument doc;
+    String requestError;
+    JsonDocument filter;
+    JsonObject filterCurrent = filter["current"].to<JsonObject>();
+    filterCurrent["european_aqi"] = true;
+    filterCurrent["pm2_5"] = true;
+    filterCurrent["pm10"] = true;
+    filterCurrent["grass_pollen"] = true;
+    filterCurrent["birch_pollen"] = true;
+    filterCurrent["alder_pollen"] = true;
+    if (!httpGetJson(url, doc, &requestError, &filter)) {
+        runtime.syncing = false;
+        copyString(runtime.lastError, sizeof(runtime.lastError), requestError.c_str());
+        if (error != nullptr) {
+            *error = requestError;
+        }
+        return false;
+    }
+
+    JsonObjectConst current = doc["current"].as<JsonObjectConst>();
+    if (current.isNull() || current["european_aqi"].isNull()) {
+        runtime.syncing = false;
+        copyString(runtime.lastError, sizeof(runtime.lastError), "Air quality payload incomplete");
+        if (error != nullptr) {
+            *error = runtime.lastError;
+        }
+        return false;
+    }
+
+    memset(&runtime.data, 0, sizeof(runtime.data));
+    runtime.data.valid = true;
+    runtime.data.europeanAqi = constrain(static_cast<int>(roundf(current["european_aqi"] | 0.0f)), 0, 200);
+    runtime.data.pm25 = static_cast<int>(roundf(current["pm2_5"] | 0.0f));
+    runtime.data.pm10 = static_cast<int>(roundf(current["pm10"] | 0.0f));
+    runtime.data.pollen = static_cast<int>(roundf((current["grass_pollen"] | 0.0f) +
+                                                  (current["birch_pollen"] | 0.0f) +
+                                                  (current["alder_pollen"] | 0.0f)));
+    runtime.hasData = true;
+    runtime.syncing = false;
+    runtime.lastSuccessMs = millis();
+    return true;
+}
+
 constexpr uint16_t kWeatherJob = 1;
