+void handleGifUpload() {
+    HTTPUpload &upload = server.upload();
+    if (upload.status == UPLOAD_FILE_START) {
+        gifUploadComplete = false;
+        gifUploadError = "";
+        if (feedsBusy() || webserverHasPendingNetworkAction()) {
+            gifUploadError = "Another network task is running";
