+void renderQuestPage() {
+    drawScreenChrome("QUESTS");
+    if (!hasQuestContent()) {
+        drawDisplayLabel("KEINE QUESTS AKTIV", 120, 96, 216, TC_DATUM, 0x3DE7, FONT_LABEL);
+        drawDisplayLabel("SETZEN VIA /API/QUESTS", 120, 132, 216, TC_DATUM, 0x3DE7, FONT_LABEL);
+        return;
+    }
+
+    uint8_t row = 0;
+    for (uint8_t index = 0; index < DASHBOARD_QUEST_COUNT; ++index) {
+        if (dashboardConfig.questTitles[index][0] == '\0' || dashboardConfig.questDates[index][0] == '\0') {
+            continue;
+        }
+        if (row >= 4) {
+            break;
+        }
+        const int y = 70 + row * 38;
+        if (row > 0) {
+            tft.drawFastHLine(12, y - 6, 216, 0x03E0);
+        }
+        drawDisplayLabel(dashboardConfig.questTitles[index], 12, y, 140, TL_DATUM, 0xAFE5, FONT_BODY);
+        const int days = questDaysUntil(dashboardConfig.questDates[index]);
+        char countdown[16];
+        if (days <= -32000) {
+            snprintf(countdown, sizeof(countdown), "?");
+        } else if (days < 0) {
+            snprintf(countdown, sizeof(countdown), "PAST");
+        } else if (days == 0) {
+            snprintf(countdown, sizeof(countdown), "HEUTE");
+        } else if (days == 1) {
+            snprintf(countdown, sizeof(countdown), "MORGEN");
+        } else {
+            snprintf(countdown, sizeof(countdown), "%d TAGE", days);
+        }
+        drawDisplayLabel(countdown, 228, y, 104, TR_DATUM, 0x07E0, FONT_BODY);
+        drawDisplayLabel(dashboardConfig.questDates[index], 12, y + 24, 140, TL_DATUM, 0x3DE7, FONT_LABEL);
+        ++row;
+    }
+}
