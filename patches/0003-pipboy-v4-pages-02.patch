+int questDaysUntil(const char *date) {
+    if (date == nullptr || date[0] == '\0') {
+        return -32000;
+    }
+
+    int year = 0;
+    int month = 0;
+    int day = 0;
+    if (sscanf(date, "%d-%d-%d", &year, &month, &day) == 3 && year > 2000 &&
+        month >= 1 && month <= 12 && day >= 1 && day <= 31) {
+        // ISO date.
+    } else if (sscanf(date, "%d.%d.%d", &day, &month, &year) == 3 && year > 2000 &&
+               month >= 1 && month <= 12 && day >= 1 && day <= 31) {
+        // German date.
+    } else {
+        return -32000;
+    }
+
+    tm target = {};
+    target.tm_year = year - 1900;
+    target.tm_mon = month - 1;
+    target.tm_mday = day;
+    target.tm_hour = 12;
+    time_t targetTime = mktime(&target);
+    time_t now = time(nullptr);
+    if (targetTime == static_cast<time_t>(-1) || now <= 0) {
+        return -32000;
+    }
+    return static_cast<int>((targetTime - now) / 86400);
+}
+
+uint8_t weatherIconId(const String &condition) {
+    String label = condition;
+    label.toUpperCase();
+    if (label.indexOf("REGEN") >= 0 || label.indexOf("NIESEL") >= 0 || label.indexOf("SCHAUER") >= 0 ||
+        label.indexOf("RAIN") >= 0 || label.indexOf("DRIZZLE") >= 0 || label.indexOf("SHOWERS") >= 0) {
+        return 2;
+    }
+    if (label.indexOf("SCHNEE") >= 0 || label.indexOf("SNOW") >= 0) {
+        return 3;
+    }
+    if (label.indexOf("GEWITTER") >= 0 || label.indexOf("STORM") >= 0 || label.indexOf("THUNDER") >= 0) {
+        return 4;
+    }
+    if (label.indexOf("NEBEL") >= 0 || label.indexOf("FOG") >= 0 || label.indexOf("MIST") >= 0) {
+        return 5;
+    }
+    if (label.indexOf("WOLK") >= 0 || label.indexOf("WOELK") >= 0 || label.indexOf("CLOUD") >= 0 ||
+        label.indexOf("OVERCAST") >= 0) {
+        return 1;
+    }
+    if (label.indexOf("KLAR") >= 0 || label.indexOf("CLEAR") >= 0 || label.indexOf("SONNE") >= 0 ||
+        label.indexOf("SUNNY") >= 0) {
+        return 0;
+    }
+    return 1;
+}
+
+void drawWeatherIcon(const String &condition, int x, int y, int scale) {
+        static const uint16_t kPipboyIconSun[16] = {0x0180, 0x0180, 0x2004, 0x1008, 0x0080, 0x03E0, 0x07F0, 0xC7F3, 0xCFFB, 0x07F0, 0x07F0, 0x03E0, 0x1088, 0x2004, 0x0180, 0x0180};
+        static const uint16_t kPipboyIconCloud[16] = {0x0000, 0x0000, 0x0040, 0x03F8, 0x07FC, 0x07FC, 0x1FFC, 0x3FFE, 0x3FFE, 0x7FFE, 0x3FFF, 0x3FFE, 0x1F7E, 0x0408, 0x0000, 0x0000};
+        static const uint16_t kPipboyIconRain[16] = {0x0040, 0x03F8, 0x07FC, 0x07FC, 0x1FFC, 0x3FFE, 0x3FFE, 0x7FFE, 0x3FFF, 0x3FFE, 0x1F7E, 0x0408, 0x0848, 0x0484, 0x0000, 0x0000};
+        static const uint16_t kPipboyIconSnow[16] = {0x0040, 0x03F8, 0x07FC, 0x07FC, 0x1FFC, 0x3FFE, 0x3FFE, 0x7FFE, 0x3FFF, 0x3FFE, 0x1F7E, 0x0408, 0x0840, 0x0004, 0x0840, 0x0000};
+        static const uint16_t kPipboyIconStorm[16] = {0x0040, 0x03F8, 0x07FC, 0x07FC, 0x1FFC, 0x3FFE, 0x3FFE, 0x7FFE, 0x3FFF, 0x3FFE, 0x1F7E, 0x0448, 0x00C0, 0x0180, 0x0100, 0x0000};
+        static const uint16_t kPipboyIconFog[16] = {0x0000, 0x0000, 0x0000, 0x0000, 0x3DDC, 0x0000, 0x0000, 0x3DDC, 0x0000, 0x0000, 0x3DDC, 0x0000, 0x0000, 0x3DDC, 0x0000, 0x0000};
+    static const uint16_t *icons[6] = {kPipboyIconSun, kPipboyIconCloud, kPipboyIconRain,
+                                       kPipboyIconSnow, kPipboyIconStorm, kPipboyIconFog};
+    const uint16_t *rows = icons[weatherIconId(condition)];
+    for (int row = 0; row < 16; ++row) {
+        uint16_t bits = rows[row];
+        for (int col = 0; col < 16; ++col) {
+            if (bits & (0x8000 >> col)) {
+                tft.fillRect(x + col * scale, y + row * scale, scale, scale, 0x07E0);
+            }
+        }
+    }
+}
+
+void drawScanlines() {
+    const ThemePalette &theme = activeTheme();
+    const uint16_t background = theme.background;
+    const uint16_t r = ((background >> 11) & 0x1F) / 3;
+    const uint16_t g = ((background >> 5) & 0x3F) / 3;
+    const uint16_t b = (background & 0x1F) / 3;
+    const uint16_t scanline = (r << 11) | (g << 5) | b;
+    for (int y = 1; y < DISPLAY_HEIGHT; y += 3) {
+        tft.drawFastHLine(0, y, DISPLAY_WIDTH, scanline);
+    }
+}
